<?xml version="1.0" encoding="utf-8"?>
<!--
Backup and device-transfer rules for Android 12 and later
(android:dataExtractionRules).

The storage plugin's values are encrypted under a Keystore key, which neither
a cloud backup nor a device transfer carries, so a restored copy could not be
decrypted. Leave it out of both.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="g3_native_plugins.storage.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="g3_native_plugins.storage.xml" />
    </device-transfer>
</data-extraction-rules>
